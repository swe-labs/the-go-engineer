package components

import "github.com/rasel9t6/the-go-engineer/curriculum/companion-frontend/stage-03-templ-tailwind/components/ui"

templ Login(flashError string, csrfToken string) {
	@Layout("Sign In", nil) {
		<div class="max-w-md mx-auto mt-12">
			@ui.Card(ui.CardProps{Class: "shadow-xl border-slate-800 bg-slate-900"}) {
				@ui.CardHeader(ui.CardHeaderProps{Class: "text-center space-y-2 p-8 pb-4"}) {
					<div class="flex justify-center">
						@ui.Badge(ui.BadgeProps{Variant: ui.BadgeVariantSecondary, Class: "bg-indigo-500/10 text-indigo-400 border-indigo-500/20"}) {
							Module 10 Auth &amp; Security
						}
					</div>
					@ui.CardTitle(ui.CardTitleProps{Class: "text-2xl font-bold text-center text-white"}) {
						Sign In to Opslane
					}
					@ui.CardDescription(ui.CardDescriptionProps{Class: "text-center text-slate-400"}) {
						Multi-tenant role-based access console
					}
				}
				@ui.CardContent(ui.CardContentProps{Class: "p-8 pt-2 space-y-4"}) {
					if flashError != "" {
						<div class="mb-4 p-3 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-sm">
							{ flashError }
						</div>
					}

					<form action="/auth/login" method="POST" class="space-y-4">
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<div class="space-y-1">
							<label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
								Work Email
							</label>
							@ui.Input(ui.InputProps{
								Type:        "email",
								ID:          "email",
								Name:        "email",
								Value:       "alice@acme.corp",
								Required:    true,
								Placeholder: "name@company.com",
							})
						</div>
						<div class="space-y-1">
							<label for="password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">
								Password
							</label>
							@ui.Input(ui.InputProps{
								Type:        "password",
								ID:          "password",
								Name:        "password",
								Value:       "opslane123",
								Required:    true,
								Placeholder: "••••••••",
							})
						</div>

						<div class="p-3 bg-slate-950 rounded border border-slate-800 text-xs text-slate-400 space-y-1">
							<p class="font-semibold text-slate-300">Test Accounts:</p>
							<p>&bull; Admin: <code class="text-indigo-400 font-mono">alice@acme.corp</code> / <code class="text-slate-300 font-mono">opslane123</code></p>
							<p>&bull; Viewer: <code class="text-indigo-400 font-mono">bob@acme.corp</code> / <code class="text-slate-300 font-mono">opslane123</code></p>
						</div>

						@ui.Button(ui.ButtonProps{
							Type:    ui.TypeSubmit,
							Variant: ui.VariantDefault,
							Class:   "w-full py-2.5",
						}) {
							Sign In
						}
					</form>
				}
			}
		</div>
	}
}
