package components

type SettingsViewModel struct {
	User         UserContext
	TenantName   string
	StrictMulti  bool
	CSRFToken    string
	FlashSuccess string
	FlashError   string
}

templ Settings(vm SettingsViewModel) {
	@Layout("Tenant Settings", &vm.User) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-bold text-white tracking-tight">Organization &amp; Tenant Configuration</h1>
				<p class="text-sm text-slate-400">Manage multi-tenancy isolation policies and workspace parameters</p>
			</div>

			if vm.FlashSuccess != "" {
				<div class="p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm">
					{ vm.FlashSuccess }
				</div>
			}

			if vm.FlashError != "" {
				<div class="p-4 rounded-lg bg-rose-500/10 border border-rose-500/30 text-rose-400 text-sm">
					{ vm.FlashError }
				</div>
			}

			if vm.User.Role != "admin" {
				<!-- Role-Based Access Guard Notice -->
				<div class="p-4 rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-300 text-sm flex items-start space-x-3">
					<span class="text-lg leading-none">&#9888;</span>
					<div>
						<span class="font-bold">Read-Only Mode:</span> You are authenticated with the <strong>Viewer</strong> role. Only workspace <strong>Admins</strong> have authorization to modify organization settings or change tenant policies.
					</div>
				</div>
			}

			<div class="bg-slate-900 border border-slate-800 rounded-xl p-6">
				<form action="/settings" method="POST" class="space-y-6">
					<!-- CSRF Token -->
					<input type="hidden" name="csrf_token" value={ vm.CSRFToken }/>

					<div class="space-y-4">
						<div>
							<label for="tenant_name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">
								Organization Name
							</label>
							<input 
								type="text" 
								id="tenant_name" 
								name="tenant_name" 
								value={ vm.TenantName } 
								disabled?={ vm.User.Role != "admin" }
								required 
								class="w-full max-w-lg bg-slate-950 border border-slate-700 disabled:border-slate-800 disabled:text-slate-500 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-indigo-500"
							/>
						</div>

						<div class="flex items-start space-x-3 pt-2">
							<input 
								type="checkbox" 
								id="strict_isolation" 
								name="strict_isolation" 
								value="true"
								checked?={ vm.StrictMulti }
								disabled?={ vm.User.Role != "admin" }
								class="mt-1 h-4 w-4 rounded border-slate-700 bg-slate-950 text-indigo-600 focus:ring-indigo-500"
							/>
							<label for="strict_isolation" class="text-sm">
								<span class="font-medium text-white block">Strict Multi-Tenant Database Isolation</span>
								<span class="text-xs text-slate-400 block">Enforce schema-per-tenant isolation at the PostgreSQL connection level (Module 14 Architecture).</span>
							</label>
						</div>
					</div>

					if vm.User.Role == "admin" {
						<div class="pt-4 border-t border-slate-800 flex items-center justify-between">
							<button 
								type="submit" 
								class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-sm rounded-lg transition"
							>
								Save Tenant Settings
							</button>
							<span class="text-xs text-slate-500">Secured with double-submit CSRF token validation</span>
						</div>
					}
				</form>
			</div>
		</div>
	}
}
